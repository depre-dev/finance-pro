# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/financepro

# Application Configuration
NODE_ENV=production
PORT=5000

# Session Secret (Generate a strong random secret for production)
SESSION_SECRET=your-super-secret-session-key-here

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Session cookie
# Set to true only when the app is served over HTTPS. A Secure cookie is not
# stored by the browser over plain http://, which would lock out an install
# reached at http://SERVER-IP:5000.
COOKIE_SECURE=false

# CORS (Optional)
# Comma-separated list of extra browser origins allowed to call this API with
# credentials. The bundled client is served from the same origin as the API and
# does not need this. Leave empty to send no CORS headers at all.
ALLOWED_ORIGINS=

# Deployment Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=your-username
PGPASSWORD=your-password
PGDATABASE=financepro